{
  "name": "ma3000",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @ma3000/shared build && pnpm --parallel --filter @ma3000/api --filter @ma3000/web dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm --filter @ma3000/shared build && pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "typescript": "~5.9.3"
  }
}
